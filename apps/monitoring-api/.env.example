# Port the monitoring API listens on
PORT=4000

# Admin credentials for dashboard login (Phase 1: single admin user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign dashboard session JWTs
JWT_SECRET=change-this-to-a-long-random-string

# Origin allowed to call the API / open dashboard WebSocket
DASHBOARD_ORIGIN=http://localhost:3000

# Where server registrations + agent tokens are persisted. Use an ABSOLUTE
# path outside the app's own deploy directory (e.g. /home/<siteuser>/data/servers.json)
# — a relative path here gets wiped every time the app directory is
# redeployed/recreated, silently losing every registered server and agent
# token. This bit us in production: an in-place redeploy that does
# `rm -rf <appdir>/*` before re-copying the build erases ./data with it.
DATA_FILE=./data/servers.json

# Same absolute-path rule as DATA_FILE above — the permanent list of IPs
# blocked after repeated failed logins.
BLOCKED_IPS_FILE=./data/blocked-ips.json

# SMTP settings — used for two things: (1) emailing you a 6-digit code
# after a correct password, which is required to actually complete login
# (real 2FA, not optional even though these vars technically are — see
# below), and (2) emailing you the attempted username/password on every
# failed login before blocking the IP on the 3rd attempt.
#
# Leave any of these unset and 2FA is skipped entirely — a correct password
# alone logs in, and failed-attempt emails just don't send (blocking still
# works, you just won't be notified). This is intentional fail-safe
# behavior, not a bug: a single-admin app must never be able to lock itself
# out permanently because a Gmail app password expired or Google is down.
# Set these once you have a working App Password and 2FA is live; if it
# ever stops working, the app quietly falls back to password-only rather
# than refusing all logins.
#
# For Gmail: generate an App Password at
# https://myaccount.google.com/apppasswords (requires 2FA enabled on that
# Google account) — do NOT use your real Gmail password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
ALERT_TO_EMAIL=your-gmail-address@gmail.com
